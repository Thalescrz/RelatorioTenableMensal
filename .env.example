# Copie este arquivo para .env e preencha somente a copia local.
# Nunca versione credenciais reais.

# Tenable Vulnerability Management e Web App Scanning
TENABLE_BASE_URL=https://cloud.tenable.com
TENABLE_ACCESS=
TENABLE_SECRET=

# Tenable Cloud Security (GraphQL)
TCS_GRAPHQL_URL=https://app.tenable.com/api/graph
TCS_API_SECRET=
TCS_USER_AGENT=SuaEmpresa/RelatorioTenableMensal/0.1.0

# TLS corporativo (opcional). Caminho absoluto de um bundle PEM.
TENABLE_CA_BUNDLE=

# Controles seguros para validacao de contrato
TENABLE_HTTP_TIMEOUT_SECONDS=30
TENABLE_VALIDATE_TLS=true

# A persistencia PostgreSQL usa um arquivo separado por seguranca:
# credentials/database.env (modelo em credentials/database.env.example).
